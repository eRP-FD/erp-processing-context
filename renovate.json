{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePaths": [
    "**/conan-recipes/**"
  ],
  "commitMessagePrefix": "renovate:",
  "postUpgradeTasks": {
    "commands": ["python3 scripts/update-dependencies-md.py"],
    "fileFilters": ["Dependencies.md"],
    "executionMode": "branch"
  },
  "packageRules": [
    {
        "matchManagers": ["docker"],
        "registryUrls": [
            "de.icr.io/erp_dev"
        ]
    },
    {
        "matchManagers": ["conan"],
        "registryUrls": [
            "https://center2.conan.io",
            "https://artifactory-cpp-ce.ihc-devops.net/artifactory/api/conan/erp-conan-2",
            "https://artifactory-cpp-ce.ihc-devops.net/artifactory/api/conan/erp-conan-internal"
        ]
    },
    {
        "description": "openssl: open as draft PR only when a newer upstream version exists. Uses regex versioning so 3.5.8+erp and 3.5.8 are considered equal, triggering only when 3.5.9+ is released.",
        "matchManagers": ["conan"],
        "matchDepNames": ["openssl"],
        "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\+erp)?$",
        "allowedVersions": "/^3\\.5\\./",
        "draftPR": true
    },
    {
        "description": "rapidjson: parse cci.YYYYMMDD snapshot dates to prevent downgrades to older cci snapshots",
        "matchManagers": ["conan"],
        "matchDepNames": ["rapidjson"],
        "versioning": "regex:^cci\\.(?<major>\\d{4})(?<minor>\\d{2})(?<patch>\\d{2})$"
    },
    {
        "description": "hsmclient: exclude from Renovate updates",
        "matchManagers": ["conan"],
        "matchDepNames": ["hsmclient"],
        "enabled": false
    },
    {
        "description": "tpmclient: exclude from Renovate updates",
        "matchManagers": ["conan"],
        "matchDepNames": ["tpmclient"],
        "enabled": false
    },
    {
        "description": "Gradle plugin org.sonarqube: pin to v5.1.0.4882.",
        "matchManagers": ["gradle"],
        "matchDepNames": ["org.sonarqube"],
        "allowedVersions": "5.1.0.4882"
    },
    {
        "description": "Gradle plugin pl.allegro.tech.build.axion-release: exclude from Renovate updates",
        "matchManagers": ["gradle"],
        "matchDepNames": ["pl.allegro.tech.build.axion-release"],
        "enabled": false
    }
  ]
}
